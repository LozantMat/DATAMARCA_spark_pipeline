# Copy to .env (cp .env.example .env) and fill in. NEVER commit .env.

# --- Airflow runtime ---------------------------------------------------------
# macOS/Linux: put the output of `id -u` here
AIRFLOW_UID=50000
# UI login (change it if you share the machine)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Generate with:
#   docker run --rm apache/airflow:3.3.1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Any long random string, e.g. `openssl rand -hex 32`
AIRFLOW__API_AUTH__JWT_SECRET=

# --- Databricks connection (conn id: databricks_default) ---------------------
# host = your workspace URL (copy it from the browser, without the path)
# password = personal access token (Settings > Developer > Access tokens)
AIRFLOW_CONN_DATABRICKS_DEFAULT='{"conn_type": "databricks", "host": "https://<your-workspace>.cloud.databricks.com", "password": "<your-token>"}'

# --- DATAMARCA settings (read in the DAG as Airflow Variables) ---------------
# Job IDs: Databricks > Jobs & Pipelines > job > "Job ID" (right panel)
AIRFLOW_VAR_DATAMARCA_PIPELINE_JOB_ID=
AIRFLOW_VAR_DATAMARCA_EXPORT_JOB_ID=
# SQL warehouse: Databricks > SQL Warehouses > warehouse > Connection details > HTTP path
AIRFLOW_VAR_DATAMARCA_SQL_HTTP_PATH=
# Optional: Slack/Discord/Teams incoming webhook (full https:// URL).
# Leave it empty to only log the notification. No inline comments here:
# Docker would read them as part of the value.
AIRFLOW_VAR_DATAMARCA_WEBHOOK_URL=
